# Vero - Phase 1. Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+psycopg://vero:vero@localhost:5432/vero

# fake = deterministic scripted provider (default, used by tests and CI)
# openai = real API calls
LLM_PROVIDER=fake
DOCUMENT_EXTRACTOR=fake

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local disk path for synthetic document uploads (S3 arrives in Phase 4)
STORAGE_DIR=./storage
