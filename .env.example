# Vero - Phase 1. Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+psycopg://vero:vero@localhost:5433/vero

# fake = deterministic scripted provider (default, used by tests and CI)
# openai = real API calls
LLM_PROVIDER=fake
DOCUMENT_EXTRACTOR=fake

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local disk path for synthetic document uploads (S3 arrives in Phase 4)
STORAGE_DIR=./storage

# Applied to every database connection as statement_timeout and lock_timeout.
# A statement waiting on a row lock is the one thing a tool can genuinely hang on.
# Zero disables the limit.
DB_STATEMENT_TIMEOUT_SECONDS=10
